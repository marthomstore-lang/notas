  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "rootDir": "./src", "outDir": "./dist"
  },
  "exclude": ["scratch", "check_grades.ts", "check_students.ts"],
  "include": ["src/**/*"]
